    "type": "commonjs",
    "engines": {
        "node": "26.x"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.9.1",
        "eslint-plugin-playwright": "^2.11.0",
        "globals": "^17.12.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.69.0"
